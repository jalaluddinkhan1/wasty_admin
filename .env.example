# Wasty Admin — environment
# Copy to `.env.local` and fill values when ready.

# Data backend: sqlite (default, local file) | firebase (Firestore) | aws (DynamoDB — production)
# Leave unset to auto-prefer firebase once Admin credentials below are present,
# otherwise the app falls back to SQLite with a console warning.
WASTY_DATA_PROVIDER=sqlite

# AWS API Gateway base URL (no trailing slash). Required when WASTY_DATA_PROVIDER=aws.
# WASTY_API_BASE_URL=https://YOUR_API.execute-api.ap-south-1.amazonaws.com

# TEMP local demo only — skip /dashboard auth redirect. Never enable in production.
# WASTY_AUTH_BYPASS=1

# Local RBAC preview while sqlite/bypass is on: owner | government | ops_manager | support
# WASTY_DEV_ADMIN_TYPE=owner

# Optional custom SQLite path (default: data/wasty-admin.sqlite)
# WASTY_SQLITE_PATH=data/wasty-admin.sqlite

# --- Firebase Web (same project as Application_mvp + Partner_Mvp) ---
# Copy these from Application_mvp/.env (EXPO_PUBLIC_FIREBASE_*) — this is
# the standard Firebase Web SDK config and is safe to expose to the browser.
# Used for: admin login (Firebase Auth email/password).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-only, never exposed to the browser) ---
# Option A — path to a service account JSON (absolute or relative to cwd).
# GOOGLE_APPLICATION_CREDENTIALS is also honored (standard Google convention).
# Never commit the JSON file itself.
# FIREBASE_ADMIN_SDK_PATH=./your-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json

# Option B — inline credential triple (use if you can't ship a JSON file,
# e.g. some hosting providers). Private key may contain literal \n.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
